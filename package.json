{
  "name": "ascstremio",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "Base de addon Stremio para integração futura com Amigos Share",
  "main": "src/index.js",
  "scripts": {
    "start": "node --max-http-header-size=65536 src/index.js",
    "dev": "node --max-http-header-size=65536 --watch src/index.js",
    "test": "npm run check",
    "check": "node --check src/ui/app.js && node --check src/ui/views.js && node --check src/ui/logs.js && node --check src/ui/settings-model.js && node --check src/ui/settings.js && node --check src/ui/admin.js && node --test test/*.test.js",
    "credenciais": "node src/credenciais-cli.js",
    "configurar": "node src/configurar-cli.js",
    "rede": "node src/rede-cli.js",
    "retencao": "node src/retencao-cli.js",
    "admin-painel": "node src/admin-cli.js",
    "alertas": "node src/alertas-cli.js",
    "bench:reproducao": "node --max-http-header-size=65536 scripts/bench-playback.js",
    "install-service": "bash scripts/install.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "parse-torrent": "11.0.24",
    "stremio-addon-sdk": "1.6.10",
    "tough-cookie": "6.1.0",
    "webtorrent": "^3.0.21"
  }
}
